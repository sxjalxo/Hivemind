# Copy to `.env` and edit. Every value below is the built-in default, so an empty
# .env is a working configuration for the docker-compose stack — override only what
# your environment actually needs.

# --- Infrastructure -------------------------------------------------------
ES_URL=http://localhost:9200
ES_INDEX=honeypot-events
PG_DSN=postgresql+asyncpg://hivemind:hivemind@localhost:5432/hivemind

# --- Local model ----------------------------------------------------------
# Used for the analysis pipeline. num_ctx is pinned at 8192 in code: measured on an
# 8 GB card, 32768 spills to a CPU/GPU split and runs several times slower, silently.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TEMPERATURE=0.3

# --- Cloud evaluator (optional) -------------------------------------------
# Supplies the realism evaluator ONLY. Leave unset and an evaluation run still
# completes, reporting evaluator_status "unavailable"; it never falls back to the
# local model, because the source paper measured sub-70b models as returning only
# superficial critique in this role.
# BYOK_PROVIDER must be "anthropic" or "openai".
# BYOK_PROVIDER=anthropic
# BYOK_API_KEY=
# BYOK_MODEL=claude-sonnet-4-5

# --- Realism evaluation ---------------------------------------------------
# The target is resolved from settings, never from an HTTP request, so there is no
# path from the API to an arbitrary host.
#
# The default "cowrie" is the compose service name and resolves only from inside the
# compose network. Running the backend on the host? Set 127.0.0.1.
# Per-honeypot targets, keyed by honeypot id, as JSON with snake_case keys.
# Leave it unset and the single EVALUATION_* target below serves every honeypot,
# which is what a one-decoy deployment wants. Set it and an unmapped honeypot id
# is REFUSED rather than sent to the default -- evaluating one honeypot under
# another's label files every score and finding against the wrong decoy.
#
# Each entry may declare "kind": "cowrie" (the default) or "generic".
#
# "generic" is for anything that is not this Cowrie image -- a real Linux VM, a bare
# host, another team's decoy. It skips the three things that only work against Cowrie:
# the container reset, the cowrie.cfg digest in the honeypot fingerprint, and chain
# verification (which reads commands back out of Cowrie's own log).
#
# It is ALSO what keeps the attack chains off a real machine. Cowrie emulates every
# command, so `rm -rf /root/.ssh` and `bash malicious_script.sh` touch nothing there.
# On a real host they do exactly what they say. Chains marked destructive in
# chains.yaml are refused against a target that does not simulate commands -- all three
# shipped chains are, so a generic target scores no attack_possibilities at all.
#
# A "cowrie" entry needs container_name; a "generic" one does not. Each entry may
# also name its own "capture_container" -- the sidecar sharing THAT honeypot's
# network namespace. Without one, no packet capture runs for that honeypot,
# which reports nothing rather than reporting another honeypot's traffic.
#
# EVALUATION_TARGETS={"cowrie-01":{"host":"127.0.0.1","ssh_port":2222,"container_name":"hivemind-cowrie-1"},"cowrie-degraded":{"host":"127.0.0.1","ssh_port":2322,"container_name":"hivemind-degraded-1"},"vm-baseline":{"kind":"generic","host":"192.0.2.10","ssh_port":22,"ssh_username":"root","ssh_password":"..."}}
#
# ---------------------------------------------------------------------------
# The degradation matrix.
#
# The four arms declared by the `matrix` compose profile, ready to paste. Bring
# them up with `docker compose --profile matrix up -d`, then run
# `python scripts/run_degradation_matrix.py` to evaluate every arm and print
# the comparison.
#
# `cowrie-01` is included and must stay included. The moment this map holds
# anything, an unmapped honeypot id is REFUSED -- so omitting the stock decoy
# here would not fall back to the single target below, it would make the
# honeypot you already have un-evaluable.
#
# EVALUATION_TARGETS={"cowrie-01":{"host":"127.0.0.1","ssh_port":2222,"container_name":"hivemind-cowrie-1","capture_container":"hivemind-capture-1"},"matrix-hardened":{"host":"127.0.0.1","ssh_port":2232,"container_name":"hivemind-cowrie-hardened-1","capture_container":"hivemind-capture-hardened-1"},"matrix-degraded-sanity":{"host":"127.0.0.1","ssh_port":2242,"container_name":"hivemind-cowrie-degraded-sanity-1","capture_container":"hivemind-capture-degraded-sanity-1"},"matrix-degraded-fs":{"host":"127.0.0.1","ssh_port":2252,"container_name":"hivemind-cowrie-degraded-fs-1","capture_container":"hivemind-capture-degraded-fs-1"}}

EVALUATION_TARGET_HOST=cowrie
EVALUATION_SSH_PORT=2222
EVALUATION_SSH_USERNAME=root
EVALUATION_SSH_PASSWORD=hivemind-evaluation
EVALUATION_CONTAINER_NAME=hivemind-cowrie-1
EVALUATION_CAPTURE_INTERFACE=eth0

# The packet-capture SIDECAR: a container docker-compose declares with
# `network_mode: service:cowrie`, so it sits in the honeypot's own network
# namespace and the interface above is the honeypot's. The backend `docker
# exec`s tcpdump into it.
#
# A sidecar rather than `docker run`, and that is a security property, not a
# style choice: creating a container is the one Docker operation
# unconditionally equivalent to root on the host, and this was the only thing
# in the application that needed one. See "Docker privilege" in the README.
#
# Clear it to disable the capture. That reports nothing rather than capturing
# on THIS host, which would watch an interface the honeypot's traffic never
# crosses and report zero packets as if that were a finding.
EVALUATION_CAPTURE_CONTAINER=hivemind-capture-1

# Hard budgets. The agent stops at whichever it hits first.
EVALUATION_AGENT_MAX_COMMANDS=40
EVALUATION_AGENT_MAX_SECONDS=120
EVALUATION_NMAP_TIMEOUT_SECONDS=120
EVALUATION_CAPTURE_TIMEOUT_SECONDS=30

# --- API ------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:8080"]

# --- Authentication (Clerk) -----------------------------------------------
# UNSET = THE API IS OPEN. Every route and both WebSocket channels answer any
# caller that can reach this port. That is the historical behaviour and is
# only defensible while the backend is bound to localhost. It is never silent:
# the backend logs a warning naming this setting on every start, and
# GET /api/status reports an `authentication` row as disconnected.
#
# Set CLERK_ISSUER and every /api route requires a valid Clerk session token.
# The issuer is your Clerk Frontend API origin -- not a secret, it is
# derivable from the publishable key every browser already holds. Find it with:
#   clerk config pull | grep -i frontend      (or read it off the dashboard)
# CLERK_ISSUER=https://your-instance.clerk.accounts.dev
#
# The origins your frontend is served from. Clerk mints tokens per application
# on an instance, so without this a token issued for a DIFFERENT app on the
# same instance verifies here and is accepted. Set it to the same value as
# CORS_ORIGINS. Empty disables the check.
# CLERK_AUTHORIZED_PARTIES=["http://localhost:8080"]
#
# Override only for a proxied or self-hosted Frontend API; defaults to
# {CLERK_ISSUER}/.well-known/jwks.json
# CLERK_JWKS_URL=
#
# Clock-skew tolerance. Clerk session tokens live ~60s, so a host clock a few
# seconds fast otherwise rejects every one of them.
# CLERK_LEEWAY_SECONDS=30
#
# --- Roles ---
# Two roles, read from the session token's `role` claim, which the instance
# feeds from the Clerk user's public_metadata.role:
#
#   admin   everything
#   viewer  read-only (every GET, plus both progress WebSockets)
#
# Requiring admin: POST /api/analyze/{id}, POST /api/reports, and
# POST /api/evaluations -- the last of which resets a honeypot's container and
# runs attack chains against it.
#
# A token with no role, or an unknown one, is a VIEWER rather than a
# rejection. The role is a Clerk claim, so anything that stops it propagating
# would otherwise lock out every account at once. Read-only cannot grant
# anything: admin routes demand the role explicitly.
#
# Nothing here configures roles -- they live on the Clerk user. Set one with:
#   clerk api /users/<id> -X PATCH -d '{"public_metadata":{"role":"admin"}}'
#
# The instance needs the claim wired once (already done for this app):
#   clerk config patch --json '{"session":{"claims":{"role":"{{user.public_metadata.role}}"}}}'

# --- Attacker profile caps ------------------------------------------------
# Exceeding a cap reports similarity as unavailable with a reason, rather than
# returning a confident number computed from truncated data.
ATTACKER_COMMAND_CARDINALITY_LIMIT=2000
ATTACKER_IP_CARDINALITY_LIMIT=500
